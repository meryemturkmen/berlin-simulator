  "facts": [
    {
      "de": "Der Kurfürstendamm begann als Reitweg der Kurfürsten zum Jagdschloss Grunewald. Zum Boulevard wurde er erst ab den 1880er-Jahren.",
      "en": "Kurfürstendamm began as a bridle path for the electors to their hunting lodge in Grunewald. It only became a boulevard from the 1880s on."
    },
    {
      "de": "Die Ruine der Kaiser-Wilhelm-Gedächtniskirche blieb nach dem Krieg bewusst als Mahnmal stehen. Die Berliner nennen sie den hohlen Zahn.",
      "en": "The ruin of the Kaiser Wilhelm Memorial Church was deliberately kept as a memorial after the war. Berliners call it the hollow tooth."
    },
    {
      "de": "Der Ku'damm ist rund 3,5 Kilometer lang. Die Hausnummern beginnen erst bei 11.",
      "en": "Ku'damm is about 3.5 kilometers long. Its house numbers only start at 11."
    }
  ],
