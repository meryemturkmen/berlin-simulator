# Copy to .env.local and fill in. Never commit real values.
# Everything is optional: with no keys the app runs in mock mode with localStorage.

# --- Qwen (Alibaba Cloud Model Studio, OpenAI-compatible API). Server only. ---
# Without a key, NPCs answer from a local mock.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash

# --- Supabase ---
# Public values, safe for the browser. Without them the app uses localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client. Used by route handlers for
# rate limits and NPC memory.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limits for NPC chat ---
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_GLOBAL_PER_DAY=2000
